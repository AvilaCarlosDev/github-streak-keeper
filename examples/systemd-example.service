[Unit]
Description=GitHub Streak Keeper - Real Maintenance Service
Documentation=https://github.com/AvilaCarlosDev/github-streak-keeper
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/carlosdev/proyectos/github-streak-keeper

# Empieza con dry-run. Cambia a STREAK_KEEPER_PUSH=1 cuando confirmes que todo está bien.
# Environment=STREAK_KEEPER_DRY_RUN=1
Environment=STREAK_KEEPER_PUSH=1

ExecStart=/home/carlosdev/proyectos/github-streak-keeper/auto-commit.sh /home/carlosdev/proyectos/mi-proyecto
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
