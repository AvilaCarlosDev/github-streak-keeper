[Unit]
Description=Run GitHub Streak Keeper every 2 hours
Documentation=https://github.com/AvilaCarlosDev/github-streak-keeper
Requires=streak-keeper.service

[Timer]
# Esperar 10 minutos después del boot
OnBootSec=10min

# Ejecutar cada 2 horas
OnUnitActiveSec=2h

# Unidad a activar
Unit=streak-keeper.service

# Hacer el timer persistente (recuerda última ejecución)
Persistent=true

[Install]
WantedBy=timers.target
