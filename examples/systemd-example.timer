[Unit]
Description=Run GitHub Streak Keeper real maintenance daily
Documentation=https://github.com/AvilaCarlosDev/github-streak-keeper
Requires=streak-keeper.service

[Timer]
# Ejecutar una vez al día a las 9:00 AM
OnCalendar=*-*-* 09:00:00

# Ejecutar si el equipo estaba apagado a esa hora
Persistent=true

# Unidad a activar
Unit=streak-keeper.service

[Install]
WantedBy=timers.target
